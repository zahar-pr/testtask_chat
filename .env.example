# Ключ доступа, который пользователь вводит на первом экране.
# От 8 до 255 символов: латинские буквы, цифры, дефис, подчёркивание.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_KEY=

# Ключ Google Gemini API: https://aistudio.google.com/apikey (бесплатная квота, карта не нужна)
GEMINI_API_KEY=

# --- Необязательные настройки (показаны значения по умолчанию) ---
# GEMINI_MODEL=gemini-3.5-flash-lite        # быстрая модель с большой бесплатной квотой
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash   # запасные, через запятую; пусто — без запасных
#   gemini-3.5-flash отвечает точнее, но на бесплатном тарифе ограничена 20 запросами в сутки.
# GEMINI_TIMEOUT_SECONDS=20      # сколько ждать одну модель, прежде чем перейти к запасной
# CONTEXT_EXCHANGES=5            # сколько предыдущих пар «вопрос — ответ» помнит модель; 0 — без контекста
# SESSION_TTL_HOURS=168          # срок жизни сессии
# LOGIN_MAX_ATTEMPTS=5           # попыток входа с одного адреса…
# LOGIN_WINDOW_SECONDS=300       # …за это время
# DATABASE_PATH=data/chat.sqlite3
# HOST=127.0.0.1
# PORT=8000

# --- Если приложение стоит за обратным прокси (nginx, Caddy, балансировщик) ---
# TRUSTED_PROXIES=127.0.0.1      # адреса прокси, чьим заголовкам X-Forwarded-For / X-Forwarded-Proto можно верить.
#                                # По ним определяются адрес клиента (лимит попыток входа) и HTTPS (флаг Secure у cookie).
# COOKIE_SECURE=auto             # auto — Secure, если запрос пришёл по HTTPS; always — всегда; never — никогда
